{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "frontend", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    },
    {
      "name": "api",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "legacy-dashboard",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "legacy-dashboard", "run", "dev", "--", "--port", "3000"],
      "port": 3000
    }
  ]
}
