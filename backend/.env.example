# Copy to .env and fill in. Never commit .env.
XKDR_API_KEY=aqi_your_key_here
AEROFUSION_REFRESH_SECONDS=43200
AEROFUSION_CORS=http://localhost:3000

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# LLM chain, tried in order: bedrock | groq | ollama
AI_PROVIDERS=bedrock,groq
# Amazon Bedrock API key (Bedrock console → API keys) — primary model
AWS_BEARER_TOKEN_BEDROCK=
BEDROCK_REGION=us-east-1
BEDROCK_MODEL=us.amazon.nova-micro-v1:0
# Your Ollama server (see deploy/ollama/README.md). Local: http://localhost:11434
OLLAMA_URL=https://your-ollama-domain.example
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_CHAT_MODEL=
# Bearer token checked by the Caddy proxy in deploy/ollama
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192
OLLAMA_TIMEOUT=600
AI_INSIGHT_TOKENS=1500
